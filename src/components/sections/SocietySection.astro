---
/** Figma 01 · The Society: scalloped arch photo + heading and body. */
import { home } from '../../data/site';
import Photo from '../ui/Photo.astro';
const s = home.society;
---
<section aria-labelledby="society-title" class="mx-auto flex max-w-[var(--container)] flex-col gap-10 px-[var(--gutter)] md:flex-row md:items-center md:gap-12 xl:gap-16">
  <div class="mask-arch aspect-[568/696] w-full max-w-[700px] shrink-0 md:w-[45%]">
    <Photo src="societyArch" alt="Two women talking at a garden table" sizes="(min-width: 768px) 45vw, 100vw" widths={[400, 700, 1136, 1400]} />
  </div>
  <div class="flex flex-col gap-8 md:max-w-[640px]">
    <div class="flex flex-col gap-1.5 md:gap-2.5">
      <p class="t-eyebrow">{s.eyebrow}</p>
      <h2 id="society-title" class="t-h2 text-ink">{s.title}</h2>
    </div>
    <div class="flex flex-col gap-4 font-sans text-[18px] leading-[1.6] text-muted">
      {s.body.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>
