---
/** Figma 05 · Become a Member (05.1) and Membership full state (05.2, `full`). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { membership as m, plans } from '../../data/site';
import Photo from '../ui/Photo.astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import KeyFact from '../blocks/KeyFact.astro';
import BenefitRow from '../blocks/BenefitRow.astro';
import PlanCard from '../blocks/PlanCard.astro';
import FaqItem from '../blocks/FaqItem.astro';
import NotifyCard from '../blocks/NotifyCard.astro';
interface Props { full?: boolean }
const { full = m.isFull } = Astro.props;
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: m.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title="Membership" description="Become a member of HER TABLE SOCIETY: early access and member pricing on selected events, plus members-only experiences. 3, 6 or 12 month plans, $50/mo equivalent. Women 27+, Los Angeles." jsonLd={faqLd} noindex={Astro.url.pathname.startsWith('/membership/full')}>
  <section class="mx-auto flex max-w-[var(--container)] flex-col gap-10 px-[var(--gutter)] pt-12 pb-[72px] md:flex-row md:items-start md:justify-between md:gap-12 md:pt-24 md:pb-[120px] xl:gap-24">
    <div class="flex flex-col gap-8 md:max-w-[624px] md:pt-2 min-[1600px]:max-w-[760px]">
      <div class="flex flex-col gap-3">
        <p class="t-eyebrow">{m.eyebrow}</p>
        <h1 class="t-h1-xl text-ink">Become<br />a member.</h1>
      </div>
      <p class="font-sans text-[18px] leading-[1.6] text-muted">{m.intro}</p>
      <dl class="flex border-y border-line">
        {m.facts.map((f, i) => <KeyFact value={f.value} label={f.label} first={i === 0} />)}
      </dl>
      {full
        ? <Button href="#notify" class="max-md:w-full">Notify me when a spot opens</Button>
        : <Button href="#plans" class="max-md:w-full">See the plans</Button>}
    </div>
    <div class="mask-arch aspect-[480/588] w-full max-w-[600px] shrink-0 max-md:order-first md:w-[40%]">
      <Photo src="optionMembership" alt="Members laughing together at a candlelit dinner" sizes="(min-width: 768px) 40vw, 100vw" widths={[400, 600, 960, 1200]} loading="eager" />
    </div>
  </section>

  <section aria-labelledby="benefits-title" class="bg-sand px-[var(--gutter)] py-[72px] md:py-[120px]">
    <div class="mx-auto flex max-w-[var(--content)] flex-col gap-10 md:flex-row md:items-center md:gap-12 xl:gap-24">
      <div class="mask-arch aspect-[480/588] w-full max-w-[600px] shrink-0 md:w-[40%]">
        <Photo src="catDinner" alt="A long dinner table of women in conversation" sizes="(min-width: 768px) 40vw, 100vw" widths={[400, 600, 960, 1200]} />
      </div>
      <div class="flex flex-1 flex-col gap-10">
        <div class="flex flex-col gap-5">
          <div class="flex flex-col gap-2.5">
            <p class="t-eyebrow">{m.benefitsEyebrow}</p>
            <h2 id="benefits-title" class="t-h2 text-ink">{m.benefitsTitle}</h2>
          </div>
          <p class="font-sans text-[18px] leading-[1.6] text-muted">{m.benefitsIntro}</p>
        </div>
        <ol>{m.benefits.map((b, i) => <BenefitRow n={i + 1} text={b} />)}</ol>
      </div>
    </div>
  </section>

  <section id="plans" aria-labelledby="plans-title" class="mx-auto flex max-w-[var(--container)] scroll-mt-24 flex-col gap-10 px-[var(--gutter)] pt-[72px] pb-12 md:gap-14 md:pt-[120px] md:pb-16">
    <div class="mx-auto flex max-w-[800px] flex-col items-center gap-4 text-center">
      {full && <Badge status="membership-full" />}
      <div class="flex flex-col gap-2">
        <p class="t-eyebrow">{m.plansEyebrow}</p>
        <h2 id="plans-title" class="t-h2 text-ink">{m.plansTitle}</h2>
      </div>
      <p class="font-sans text-[18px] leading-[1.6] text-muted">{m.plansNote}</p>
    </div>
    <fieldset class="grid gap-4 md:grid-cols-3 md:gap-6" disabled={full} data-plan-picker>
      <legend class="sr-only">Choose a plan</legend>
      {plans.map((p) => <PlanCard plan={p} name="plan" selected={p.id === '6-months'} />)}
    </fieldset>
  </section>

  {full ? (
    <section class="flex justify-center px-[var(--gutter)] pb-[72px] md:pb-[120px]"><NotifyCard /></section>
  ) : (
    <section aria-labelledby="how-title" class="mx-auto flex max-w-[var(--container)] flex-col gap-10 px-[var(--gutter)] pb-[72px] md:items-center md:pb-[120px] md:text-center">
      <div class="flex flex-col gap-4 md:items-center md:gap-5">
        <h2 id="how-title" class="t-eyebrow">{m.howTitle}</h2>
        <ol class="flex flex-col items-start gap-3 md:flex-row md:flex-wrap md:justify-center md:gap-x-3 md:gap-y-4">
          {m.howSteps.map((s, i) => (
            <>
              <li class="flex items-center gap-3 md:flex-col md:gap-2.5">
                <span class="grid size-8 place-items-center rounded-full border border-ink bg-cream font-sans text-[14px] font-medium text-ink">{i + 1}</span>
                <span class="font-sans text-[14px] leading-5 text-ink">{s}</span>
              </li>
              {i < m.howSteps.length - 1 && <li aria-hidden="true" class="mt-4 hidden h-px w-12 bg-silver md:block"></li>}
            </>
          ))}
        </ol>
      </div>
      <div class="flex w-full flex-col gap-4 md:items-center">
        <Button href="/join?plan=6-months" class="max-md:w-full" data-join>{m.join.label}</Button>
        <p class="font-sans text-[14px] leading-5 text-muted italic">{m.joinNote}</p>
      </div>
    </section>
  )}

  <section aria-labelledby="faq-title" class="bg-sand px-[var(--gutter)] py-[72px] md:py-[120px]">
    <div class="mx-auto flex max-w-[var(--content)] flex-col gap-10 lg:flex-row lg:justify-between lg:gap-24">
      <div class="max-lg:contents lg:flex lg:w-[400px] lg:shrink-0 lg:flex-col lg:gap-5">
        <div class="flex flex-col gap-2.5">
          <p class="t-eyebrow">{m.faqEyebrow}</p>
          <h2 id="faq-title" class="t-h2 text-ink">Renewal<br class="max-lg:hidden" /> &amp; cancellation.</h2>
        </div>
        <p class="font-sans text-[18px] leading-[1.6] text-muted max-lg:order-last">Still wondering? Write to <a href="mailto:hello@hertablesociety.com" class="underline-offset-4 hover:underline">hello@hertablesociety.com</a></p>
      </div>
      <div class="lg:max-w-[880px] lg:flex-1 [&>details:first-child]:border-t [&>details:first-child]:border-silver">
        {m.faq.map((f) => <FaqItem q={f.q} a={f.a} open={f.open} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const join = document.querySelector<HTMLAnchorElement>('[data-join]');
  document.querySelectorAll<HTMLInputElement>('[data-plan-picker] input[name="plan"]').forEach((r) =>
    r.addEventListener('change', () => { if (join && r.checked) join.href = `/join?plan=${r.value}`; }));
</script>
