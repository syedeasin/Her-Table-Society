  {name === 'menu' && <path d="M3 7H21M3 12H21M3 17H21" stroke="currentColor" stroke-linecap="round" />}
  {name === 'close' && <path d="M5 5L19 19M19 5L5 19" stroke="currentColor" stroke-linecap="round" />}
