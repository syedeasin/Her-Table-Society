---
/**
 * Icons exported from Figma (section 09 and page frames). All use currentColor so they follow text color.
 */
import type { IconName } from '../../lib/icons';
interface Props { name: IconName; size?: number; class?: string; label?: string }
const { name, size, class: cls, label } = Astro.props;
const box: Record<IconName, number> = {
  caret: 16, menu: 24, close: 24, x: 24, instagram: 24, facebook: 24, flag: 14, lock: 14, plus: 20, minus: 20,
  success: 56, 'radio-on': 20, 'radio-off': 20, 'check-on': 16, 'check-off': 16,
};
const vb = box[name];
const s = size ?? vb;
const a11y: Record<string, string> = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' as const };
---
