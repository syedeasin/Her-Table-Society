---
/** Figma "FAQ Item" (Collapsed / Expanded): native <details> so it works without JS. */
import Icon from '../ui/Icon.astro';
interface Props { q: string; a: string; open?: boolean }
const { q, a, open = false } = Astro.props;
---
<details class="group border-b border-silver py-6" open={open}>
  <summary class="flex cursor-pointer list-none items-start justify-between gap-6 [&::-webkit-details-marker]:hidden">
    <span class="font-serif text-[24px] leading-[1.1] tracking-[-0.02em] text-ink md:text-[28px]">{q}</span>
    <span class="mt-1 shrink-0 text-ink"><Icon name="plus" class="group-open:hidden" /><Icon name="minus" class="hidden group-open:block" /></span>
  </summary>
  <p class="mt-3 font-sans text-[16px] leading-[1.6] text-muted md:text-[18px]">{a}</p>
</details>
