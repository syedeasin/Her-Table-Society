---
/** Figma "Member Prompt" on checkout: sand strip with log-in link. */
interface Props { text: string; href?: string }
const { text, href = '/account/login' } = Astro.props;
---
<div class="flex flex-col gap-1.5 bg-sand px-4 py-3.5 md:flex-row md:items-center md:justify-between md:gap-4 md:px-5 md:py-4">
  <p class="font-sans text-[14px] leading-5 text-ink md:text-[16px] md:leading-6">{text}</p>
  <a href={href} class="t-link shrink-0 text-ink">Log in  →</a>
</div>
