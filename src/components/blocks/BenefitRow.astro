---
/** Figma "Benefit Row": number Jost Medium 14 + Cormorant 26 text, divider. */
interface Props { n: number; text: string }
const { n, text } = Astro.props;
---
<li class="flex gap-6 border-b border-silver py-5">
  <span class="w-5 shrink-0 pt-1.5 font-sans text-[14px] font-medium leading-5 text-ink">{String(n).padStart(2, '0')}</span>
  <span class="font-serif text-[22px] leading-[1.25] tracking-[-0.02em] text-ink md:text-[26px]">{text}</span>
</li>
