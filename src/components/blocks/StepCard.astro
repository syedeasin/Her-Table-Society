---
/** Figma "Step Card" (Welcome · What's next). */
import Mixed from '../ui/Mixed.astro';
interface Props { n: number; title: string; body: string }
const { n, title, body } = Astro.props;
---
<li class="flex flex-col gap-2.5 border border-line p-6">
  <span class="font-sans text-[22px] font-medium leading-none text-ink">{String(n).padStart(2, '0')}</span>
  <p class="font-serif text-[26px] leading-[1.1] tracking-[-0.02em] text-ink"><Mixed text={title} /></p>
  <p class="font-sans text-[16px] leading-[1.6] text-muted">{body}</p>
</li>
