---
/** Figma "Step Item" (Members first): number Jost Medium 26, title Cormorant 28, body 18 muted. */
interface Props { n: number; title: string; body: string }
const { n, title, body } = Astro.props;
---
<li class="flex gap-4 border-t border-silver py-5 md:gap-8 md:py-7">
  <span class="w-7 shrink-0 font-sans text-[20px] font-medium leading-none text-ink md:w-9 md:text-[26px]">{String(n).padStart(2, '0')}</span>
  <div class="flex flex-col gap-1 md:gap-1.5">
    <p class="font-serif text-[22px] leading-[1.1] tracking-[-0.02em] text-ink md:text-[28px]">{title}</p>
    <p class="font-sans text-[18px] leading-[1.6] text-muted">{body}</p>
  </div>
</li>
