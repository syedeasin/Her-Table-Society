---
/** Eyebrow + italic H2 (+ optional intro) used across sections. */
interface Props { eyebrow?: string; title: string; intro?: string; align?: 'left' | 'center'; as?: 'h1' | 'h2'; class?: string; titleClass?: string }
const { eyebrow, title, intro, align = 'left', as: H = 'h2', class: cls, titleClass = 't-h2' } = Astro.props;
---
<div class:list={['flex flex-col gap-4 md:gap-5', align === 'center' && 'items-center text-center', cls]}>
  <div class="flex flex-col gap-1.5 md:gap-2.5">
    {eyebrow && <p class="t-eyebrow">{eyebrow}</p>}
    <H class:list={[titleClass, 'text-ink']} set:html={title.replace(/\n/g, '<br />')} />
  </div>
  {intro && <p class="max-w-[720px] font-sans text-[18px] leading-[1.6] text-muted">{intro}</p>}
  <slot />
</div>
