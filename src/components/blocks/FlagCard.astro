---
/** Figma "Flag Card" (Red / Green): chip with pennant icon + Cormorant 32 (mobile 24) white text. */
import Icon from '../ui/Icon.astro';
interface Props { type: 'red' | 'green'; text: string }
const { type, text } = Astro.props;
---
<div class:list={['flex flex-1 flex-col gap-4 p-6 text-white', type === 'red' ? 'bg-red' : 'bg-green']}>
  <p class="flex items-center gap-2 font-sans text-[14px] leading-5 tracking-[0.1em] uppercase"><Icon name="flag" />{type === 'red' ? 'Red flag' : 'Green flag'}</p>
  <p class="font-serif text-[24px] leading-[1.15] tracking-[-0.02em] md:text-[32px] md:leading-[1.1]">{text}</p>
</div>
