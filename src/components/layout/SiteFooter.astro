---
/** Figma "Site Footer": photo with ink gradient, title, socials, contact email, legal row. */
import { site } from '../../data/site';
import Photo from '../ui/Photo.astro';
import Icon from '../ui/Icon.astro';
---
<footer class="on-dark relative isolate overflow-hidden bg-ink text-sand">
  <div class="absolute inset-0 -z-10">
    <Photo src="footer" alt="" sizes="100vw" class="object-[center_40%] brightness-[0.78] grayscale" />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,var(--color-ink)_23%,rgb(27_26_24/0)_79%)] max-md:bg-[linear-gradient(180deg,rgb(27_26_24/0.92)_30%,rgb(27_26_24/0.55)_100%)]"></div>
  </div>
  <div class="mx-auto flex max-w-[var(--container)] flex-col gap-[72px] px-[var(--gutter)] pt-[72px] pb-12 lg:gap-[220px] lg:pt-[120px] lg:pb-20">
    <div class="flex flex-col gap-12 lg:gap-16">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
        <p class="max-w-[600px] font-serif text-[48px] italic leading-[0.8] tracking-[-0.03em] text-sand lg:text-[96px]">No two tables are<br />the same.</p>
        <ul class="-ml-3 flex lg:ml-0" aria-label="Social media">
          {site.social.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener" class="grid p-3 text-sand transition-opacity hover:opacity-70" aria-label={`${site.name} on ${s.label}`}><Icon name={s.icon as 'x'} /></a></li>
          ))}
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <p class="font-serif text-[24px] italic leading-[1.2] tracking-[-0.02em] text-sand/60 lg:text-[32px]">Contact us</p>
        <a href={`mailto:${site.email}`} class="w-max max-w-full break-all font-serif text-[28px] leading-[1.1] tracking-[-0.02em] text-sand hover:underline md:text-[44px] lg:text-[64px]">{site.email}</a>
      </div>
    </div>
    <div class="flex flex-col gap-2 font-sans text-[16px] leading-[1.6] lg:flex-row lg:items-center lg:justify-between lg:text-[18px]">
      <ul class="flex gap-8">
        <li><a href="/privacy-policy" class="inline-block py-6 hover:underline">Privacy Policy</a></li>
      </ul>
      <p>© {site.year} {site.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
