---
/** Simple prose layout for legal pages (no Figma frame; uses the site type scale). */
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; description: string; updated?: string }
const { title, description, updated = 'November 2026' } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <article class="mx-auto flex max-w-[calc(760px+2*var(--gutter))] flex-col gap-8 px-[var(--gutter)] pt-12 pb-[72px] md:pt-24 md:pb-[120px]">
    <header class="flex flex-col gap-3">
      <p class="t-eyebrow">Last updated {updated}</p>
      <h1 class="t-h1 text-ink">{title}</h1>
    </header>
    <div class="flex flex-col gap-5 font-sans text-[18px] leading-[1.6] text-muted [&_a]:text-ink [&_a]:underline [&_a]:underline-offset-4 [&_h2]:mt-6 [&_h2]:font-serif [&_h2]:text-[32px] [&_h2]:italic [&_h2]:leading-none [&_h2]:tracking-[-0.03em] [&_h2]:text-ink [&_li]:ml-5 [&_li]:list-['—__'] [&_strong]:font-medium [&_strong]:text-ink [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-2">
      <slot />
    </div>
  </article>
</BaseLayout>
